{
  "name": "helen-contains-claude (sandboxed)",
  "initializeCommand": "bash .devcontainer/run.sh --build-only",
  "image": "helen-contains-claude-devcontainer",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=helen-contains-claude-claude-config,target=/state/claude-config,type=volume",
    "source=helen-contains-claude-bundle-cache,target=/state/bundle,type=volume"
  ],
  "remoteEnv": {
    "AGENT_GH_TOKEN": "${localEnv:AGENT_GH_TOKEN}"
  },
  "updateRemoteUserUID": false
}
